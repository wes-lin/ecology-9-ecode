{
  "name": "vscode-ecode",
  "displayName": "eCode Explorer",
  "description": "Browse and download Ecology 9 ecode files from VS Code",
  "icon": "assets/ecode.png",
  "version": "0.0.1",
  "publisher": "ecode-dev-assistant",
  "repository": {
    "url": "https://github.com/wes-lin/ecology-9-ecode/tree/main/packages/vscode-ecode"
  },
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "eCode",
      "properties": {
        "ecode.baseUrl": {
          "type": "string",
          "default": "http://localhost",
          "description": "eCode server base URL"
        },
        "ecode.username": {
          "type": "string",
          "default": "",
          "description": "eCode login account"
        },
        "ecode.password": {
          "type": "string",
          "default": "",
          "description": "eCode login password"
        },
        "ecode.localDir": {
          "type": "string",
          "default": "src",
          "description": "Local directory to download ecode source files"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ecode",
          "title": "eCode",
          "icon": "assets/ecode.svg"
        }
      ]
    },
    "views": {
      "ecode": [
        {
          "id": "ecodeExplorer",
          "name": "Explorer",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "ecode.refresh",
        "title": "eCode: Refresh Explorer",
        "icon": "$(refresh)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.refreshFolder",
        "title": "eCode: Refresh Folder",
        "icon": "$(refresh)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.download",
        "title": "eCode: Download",
        "icon": "$(cloud-download)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.openLocalFile",
        "title": "eCode: Open Local File",
        "icon": "$(go-to-file)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.compareWithRemote",
        "title": "eCode: Compare with Remote",
        "icon": "$(diff)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.deleteItem",
        "title": "eCode: Delete",
        "icon": "$(trash)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.openSettings",
        "title": "eCode: Open Settings",
        "icon": "$(gear)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.viewFile",
        "title": "eCode: View Remote File",
        "enablement": "!ecodeExplorer.busy"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ecode.refresh",
          "when": "view == ecodeExplorer && !ecodeExplorer.busy",
          "group": "navigation"
        },
        {
          "command": "ecode.openSettings",
          "when": "view == ecodeExplorer && !ecodeExplorer.busy",
          "group": "navigation"
        },
        {
          "command": "ecode.download",
          "when": "view == ecodeExplorer && !ecodeExplorer.busy",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ecode.refreshFolder",
          "when": "view == ecodeExplorer && !ecodeExplorer.busy && viewItem =~ /folder/",
          "group": "navigation"
        },
        {
          "command": "ecode.deleteItem",
          "when": "view == ecodeExplorer && !ecodeExplorer.busy && viewItem =~ /deletable/",
          "group": "navigation"
        },
        {
          "command": "ecode.openLocalFile",
          "when": "view == ecodeExplorer && !ecodeExplorer.busy && viewItem =~ /file/",
          "group": "inline"
        },
        {
          "command": "ecode.compareWithRemote",
          "when": "view == ecodeExplorer && !ecodeExplorer.busy && viewItem =~ /file/",
          "group": "navigation"
        },
        {
          "command": "ecode.viewFile",
          "when": "view == ecodeExplorer && !ecodeExplorer.busy && viewItem =~ /file/",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "build:production": "node esbuild.js --production",
    "vscode:prepublish": "pnpm run build:production",
    "package": "pnpm run build:production && node scripts/ensure-releases-dir.js && vsce package --no-dependencies --out releases",
    "lint": "echo 'Run lint from root'",
    "test": "echo 'No tests yet'"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1"
  }
}
