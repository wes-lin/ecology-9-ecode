{
  "name": "vscode-ecode",
  "displayName": "eCode Explorer",
  "description": "Browse and download Ecology 9 ecode files from VS Code",
  "version": "0.1.0",
  "publisher": "ecode-dev-assistant",
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "eCode",
      "properties": {
        "ecode.baseUrl": {
          "type": "string",
          "default": "http://localhost",
          "description": "eCode server base URL"
        },
        "ecode.username": {
          "type": "string",
          "default": "",
          "description": "eCode login account"
        },
        "ecode.password": {
          "type": "string",
          "default": "",
          "description": "eCode login password"
        },
        "ecode.localDir": {
          "type": "string",
          "default": "src",
          "description": "Local directory to download ecode source files"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ecode",
          "title": "eCode",
          "icon": "assets/ecode.svg"
        }
      ]
    },
    "views": {
      "ecode": [
        {
          "id": "ecodeExplorer",
          "name": "Explorer",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "ecode.refresh",
        "title": "eCode: Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "ecode.refreshFolder",
        "title": "eCode: Refresh Folder",
        "icon": "$(refresh)"
      },
      {
        "command": "ecode.download",
        "title": "eCode: Download",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ecode.openLocalFile",
        "title": "eCode: Open Local File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ecode.compareWithRemote",
        "title": "eCode: Compare with Remote",
        "icon": "$(diff)"
      },
      {
        "command": "ecode.deleteItem",
        "title": "eCode: Delete",
        "icon": "$(trash)"
      },
      {
        "command": "ecode.openSettings",
        "title": "eCode: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "ecode.viewFile",
        "title": "eCode: View Remote File"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ecode.refresh",
          "when": "view == ecodeExplorer",
          "group": "navigation"
        },
        {
          "command": "ecode.openSettings",
          "when": "view == ecodeExplorer",
          "group": "navigation"
        },
        {
          "command": "ecode.download",
          "when": "view == ecodeExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ecode.refreshFolder",
          "when": "view == ecodeExplorer && (viewItem == folder || viewItem == folder-deletable)",
          "group": "navigation"
        },
        {
          "command": "ecode.deleteItem",
          "when": "view == ecodeExplorer && (viewItem == file-deletable || viewItem == folder-deletable)",
          "group": "navigation"
        },
        {
          "command": "ecode.openLocalFile",
          "when": "view == ecodeExplorer && viewItem == file",
          "group": "inline"
        },
        {
          "command": "ecode.compareWithRemote",
          "when": "view == ecodeExplorer && viewItem == file",
          "group": "navigation"
        },
        {
          "command": "ecode.viewFile",
          "when": "view == ecodeExplorer && viewItem == file",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "echo 'No build step required'",
    "lint": "echo 'Run lint from root'",
    "test": "echo 'No tests yet'"
  },
  "dependencies": {
    "ecode-sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  }
}
