{
  "name": "vscode-ecode",
  "displayName": "eCode Explorer",
  "description": "Browse and download Ecology 9 ecode files from VS Code",
  "icon": "assets/ecode.png",
  "version": "0.0.8",
  "publisher": "ecode-dev-assistant",
  "repository": {
    "url": "https://github.com/wes-lin/ecology-9-ecode/tree/main/packages/vscode-ecode"
  },
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "eCode",
      "properties": {
        "ecode.environments": {
          "type": "array",
          "default": [],
          "description": "Named eCode environments. Use the eCode: Manage Environments command for a visual editor.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "baseUrl",
              "username",
              "password",
              "localDir"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Environment name"
              },
              "baseUrl": {
                "type": "string",
                "description": "eCode server base URL"
              },
              "username": {
                "type": "string",
                "description": "eCode login account"
              },
              "password": {
                "type": "string",
                "description": "eCode login password"
              },
              "localDir": {
                "type": "string",
                "description": "Local directory to download ecode source files"
              }
            }
          }
        },
        "ecode.activeEnvironment": {
          "type": "string",
          "default": "",
          "description": "Active eCode environment name"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ecode",
          "title": "eCode",
          "icon": "assets/ecode.svg"
        }
      ]
    },
    "views": {
      "ecode": [
        {
          "id": "ecodeLocalExplorer",
          "name": "Local",
          "when": "true"
        },
        {
          "id": "ecodeExplorer",
          "name": "Remote",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "ecode.switchEnvironment",
        "title": "Switch Environment",
        "icon": "$(server-environment)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.refreshFolder",
        "title": "Refresh",
        "icon": "$(refresh)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.download",
        "title": "Download",
        "icon": "$(cloud-download)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.compareWithRemote",
        "title": "Compare with Remote",
        "icon": "$(diff)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.deleteItem",
        "title": "Delete",
        "icon": "$(trash)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.openSettings",
        "title": "Manage Environments",
        "category": "eCode",
        "icon": "$(gear)",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.viewFile",
        "title": "View Remote File",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.release",
        "title": "Release",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.cancelRelease",
        "title": "Cancel Release",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.setPreload",
        "title": "Preload",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.cancelPreload",
        "title": "Cancel Preload",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.setPreloadOrder",
        "title": "Preload Order",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.createNewApp",
        "title": "New App",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.createNewType",
        "title": "New Type",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.createNewFolder",
        "title": "New Folder",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.createNewJs",
        "title": "New JS",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.createNewCss",
        "title": "New CSS",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.createNewMd",
        "title": "New Markdown",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.renameItem",
        "title": "Rename",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.uploadResource",
        "title": "Upload Resource",
        "enablement": "!ecodeExplorer.busy"
      },
      {
        "command": "ecode.local.refresh",
        "title": "Refresh Local Tree",
        "icon": "$(refresh)",
        "category": "eCode"
      },
      {
        "command": "ecode.local.openFile",
        "title": "Open Local File",
        "category": "eCode"
      },
      {
        "command": "ecode.local.createNewApp",
        "title": "New Local App",
        "category": "eCode"
      },
      {
        "command": "ecode.local.createNewType",
        "title": "New Local Type",
        "category": "eCode"
      },
      {
        "command": "ecode.local.createNewFolder",
        "title": "New Local Folder",
        "category": "eCode"
      },
      {
        "command": "ecode.local.createNewJs",
        "title": "New Local JS",
        "category": "eCode"
      },
      {
        "command": "ecode.local.createNewCss",
        "title": "New Local CSS",
        "category": "eCode"
      },
      {
        "command": "ecode.local.createNewMd",
        "title": "New Local Markdown",
        "category": "eCode"
      },
      {
        "command": "ecode.local.uploadResource",
        "title": "Add Local Resource",
        "category": "eCode"
      },
      {
        "command": "ecode.local.renameItem",
        "title": "Rename Local Item",
        "category": "eCode"
      },
      {
        "command": "ecode.local.deleteItem",
        "title": "Delete Local Item",
        "icon": "$(trash)",
        "category": "eCode"
      },
      {
        "command": "ecode.local.release",
        "title": "Set Local App Released",
        "category": "eCode"
      },
      {
        "command": "ecode.local.cancelRelease",
        "title": "Set Local App Unreleased",
        "category": "eCode"
      },
      {
        "command": "ecode.local.setPreload",
        "title": "Set Local File Preload",
        "category": "eCode"
      },
      {
        "command": "ecode.local.cancelPreload",
        "title": "Cancel Local File Preload",
        "category": "eCode"
      },
      {
        "command": "ecode.local.setPreloadOrder",
        "title": "Set Local App Preload Order",
        "category": "eCode"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ecode.switchEnvironment",
          "when": "view == ecodeLocalExplorer",
          "group": "navigation@0"
        },
        {
          "command": "ecode.local.refresh",
          "when": "view == ecodeLocalExplorer",
          "group": "navigation@1"
        },
        {
          "command": "ecode.download",
          "when": "view == ecodeLocalExplorer && !ecodeExplorer.busy",
          "group": "navigation@2"
        },
        {
          "command": "ecode.openSettings",
          "when": "view == ecodeLocalExplorer",
          "group": "navigation@3"
        },
        {
          "command": "ecode.refresh",
          "when": "view == ecodeExplorer && !ecodeExplorer.busy",
          "group": "navigation@0"
        },
        {
          "command": "ecode.openSettings",
          "when": "view == ecodeExplorer",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ecode.refreshFolder",
          "when": "view == ecodeExplorer && viewItem =~ /canRefreshFolder/",
          "group": "navigation@0"
        },
        {
          "command": "ecode.viewFile",
          "when": "view == ecodeExplorer && viewItem =~ /canViewRemote/",
          "group": "inline@0"
        },
        {
          "command": "ecode.compareWithRemote",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanCompareRemote/",
          "group": "inline@1"
        },
        {
          "command": "ecode.createNewApp",
          "when": "view == ecodeExplorer && viewItem =~ /canCreateNewApp/",
          "group": "new@0"
        },
        {
          "command": "ecode.createNewType",
          "when": "view == ecodeExplorer && viewItem =~ /canCreateNewType/",
          "group": "new@1"
        },
        {
          "command": "ecode.createNewFolder",
          "when": "view == ecodeExplorer && viewItem =~ /canCreateNewFolder/",
          "group": "new@2"
        },
        {
          "command": "ecode.createNewJs",
          "when": "view == ecodeExplorer && viewItem =~ /canCreateNewJs/",
          "group": "new@3"
        },
        {
          "command": "ecode.createNewCss",
          "when": "view == ecodeExplorer && viewItem =~ /canCreateNewCss/",
          "group": "new@4"
        },
        {
          "command": "ecode.createNewMd",
          "when": "view == ecodeExplorer && viewItem =~ /canCreateNewMd/",
          "group": "new@5"
        },
        {
          "command": "ecode.uploadResource",
          "when": "view == ecodeExplorer && viewItem =~ /canUploadResource/",
          "group": "new@6"
        },
        {
          "command": "ecode.release",
          "when": "view == ecodeExplorer && viewItem =~ /canRelease/",
          "group": "release@0"
        },
        {
          "command": "ecode.cancelRelease",
          "when": "view == ecodeExplorer && viewItem =~ /canCancelRelease/",
          "group": "release@1"
        },
        {
          "command": "ecode.setPreload",
          "when": "view == ecodeExplorer && viewItem =~ /canSetScriptPreload/",
          "group": "preload@0"
        },
        {
          "command": "ecode.cancelPreload",
          "when": "view == ecodeExplorer && viewItem =~ /canCancelPreload/",
          "group": "preload@1"
        },
        {
          "command": "ecode.setPreloadOrder",
          "when": "view == ecodeExplorer && viewItem =~ /canSetPreloadOrder/",
          "group": "preload@2"
        },
        {
          "command": "ecode.renameItem",
          "when": "view == ecodeExplorer && viewItem =~ /canRename/",
          "group": "modify@0"
        },
        {
          "command": "ecode.deleteItem",
          "when": "view == ecodeExplorer && viewItem =~ /canDelete/",
          "group": "modify@1"
        },
        {
          "command": "ecode.local.openFile",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localFile/",
          "group": "inline@0"
        },
        {
          "command": "ecode.local.refresh",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localFolder/",
          "group": "navigation@0"
        },
        {
          "command": "ecode.local.createNewApp",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanCreateApp/",
          "group": "new@0"
        },
        {
          "command": "ecode.local.createNewType",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanCreateType/",
          "group": "new@1"
        },
        {
          "command": "ecode.local.createNewFolder",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanCreateChild/",
          "group": "new@2"
        },
        {
          "command": "ecode.local.createNewJs",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanCreateChild/",
          "group": "new@3"
        },
        {
          "command": "ecode.local.createNewCss",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanCreateChild/",
          "group": "new@4"
        },
        {
          "command": "ecode.local.createNewMd",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanCreateChild/",
          "group": "new@5"
        },
        {
          "command": "ecode.local.uploadResource",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanUploadResource/",
          "group": "new@6"
        },
        {
          "command": "ecode.local.release",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanRelease/",
          "group": "release@0"
        },
        {
          "command": "ecode.local.cancelRelease",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanCancelRelease/",
          "group": "release@1"
        },
        {
          "command": "ecode.local.setPreload",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanSetPreload/",
          "group": "preload@0"
        },
        {
          "command": "ecode.local.cancelPreload",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanCancelPreload/",
          "group": "preload@1"
        },
        {
          "command": "ecode.local.setPreloadOrder",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localApp/",
          "group": "preload@2"
        },
        {
          "command": "ecode.local.renameItem",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanRename/",
          "group": "modify@0"
        },
        {
          "command": "ecode.local.deleteItem",
          "when": "view == ecodeLocalExplorer && viewItem =~ /localCanDelete/",
          "group": "modify@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build:production": "node esbuild.js --production",
    "vscode:prepublish": "pnpm run build:production",
    "package": "pnpm run build:production && node scripts/ensure-releases-dir.js && vsce package --no-dependencies --out releases",
    "lint": "echo 'Run lint from root'",
    "test": "echo 'No tests yet'"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1"
  }
}
